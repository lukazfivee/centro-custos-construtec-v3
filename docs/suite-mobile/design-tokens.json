{
  "fonte": "Protótipo 'App mobile Construtec' (canvas Design), rodadas 8 e 12 a 16",
  "font": {
    "family": "IBM Plex Sans",
    "fallback": "\"Segoe UI\", system-ui, sans-serif",
    "weights": [400, 500, 600, 700],
    "google": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap",
    "scale": { "caption": 11, "small": 12, "body": 13.5, "input": 15, "button": 15, "titleCard": 20, "titleScreen": 22, "hero": 26 }
  },
  "color": {
    "auth": {
      "bg": "#021820",
      "blobA": "#12a9d1", "blobB": "#0b5a70", "blobC": "#1a4da1",
      "text": "#fefefe", "textMuted": "#b9d4dd", "textSubtle": "#6f8f9b",
      "accent": "#12a9d1", "accentLight": "#5fd0ee", "accentDark": "#0d7f9f",
      "glassFill": "rgba(255,255,255,.07)", "glassBorder": "rgba(255,255,255,.16)",
      "inputFill": "rgba(255,255,255,.08)", "inputBorder": "rgba(255,255,255,.18)",
      "warning": "#f2b544", "success": "#3ccf8e", "strong": "#3ddc84",
      "overlay": "rgba(2,16,22,.78)"
    },
    "appLight": {
      "bg": "#f2f8fa", "surface": "#fefefe", "text": "#0b2530", "divider": "#d6e4e9",
      "neutral300": "#5d7480", "neutral600": "#bad0d8", "accent300": "#0a7896", "accent500": "#12a9d1",
      "accent700": "#0b4a5c", "accent900": "#e8f8fc", "tab": "#031f29",
      "warnSoft": "#fff5d9", "warnBar": "#e0a33a", "warnText": "#6b4200", "badge": "#b8452c"
    },
    "appDark": {
      "bg": "#031f29", "surface": "#0b2f3b", "text": "#f2f8fa", "divider": "#164656",
      "neutral300": "#b9d4dd", "neutral600": "#2e5463", "accent300": "#5fd0ee", "accent500": "#12a9d1",
      "accent700": "#0b5a70", "accent900": "#0a3a48", "tab": "#021820",
      "warnSoft": "#3a2a0c", "warnBar": "#e0a33a", "warnText": "#f2b544"
    }
  },
  "radius": { "input": 12, "button": 12, "card": 22, "tile": 13, "pinKey": 20, "chip": 18, "appCard": 12, "sheet": 28 },
  "size": { "touchMin": 44, "input": 48, "buttonPrimary": 52, "pinKey": 64, "pinDot": 14, "avatar": 64, "statusBarInset": 30, "contentTop": 60 },
  "shadow": {
    "glassCard": "inset 0 0 0 1px rgba(255,255,255,.16), 0 20px 50px rgba(0,0,0,.35)",
    "buttonPrimary": "0 10px 24px rgba(18,169,209,.28)",
    "logoGlow": "drop-shadow(0 6px 14px rgba(18,169,209,.4))"
  },
  "effects": {
    "glassBlur": "blur(18px) saturate(140%)",
    "cursorGlow": "radial-gradient(180px circle at {x}px {y}px, rgba(95,208,238,.22), transparent 70%)",
    "dotGrid": "radial-gradient(rgba(255,255,255,.07) 1px, transparent 1px) / 18px 18px",
    "buttonGradient": "linear-gradient(100deg, #12a9d1, #0d7f9f)"
  },
  "motion": {
    "easeOut": "cubic-bezier(.2,.8,.2,1)",
    "shakeEase": "cubic-bezier(.36,.07,.19,.97)",
    "durations": { "shake": 0.42, "stepIn": 0.35, "fadeUp": 0.6, "blobA": 14, "blobB": 17, "blobC": 19, "bob": 3.2, "shimmer": 3.2, "scan": 1.1, "successTotal": 1.3, "bioToEnter": 1.6 },
    "success": {
      "check": { "keyframe": "ctCheck", "duration": 1.05, "delay": 0 },
      "ring": { "keyframe": "ctRing", "duration": 0.55, "delay": 0.7 },
      "burst": { "keyframe": "ctBurst", "duration": 0.6, "delay": 0.74, "particles": 10, "stepDeg": 36, "big": { "size": 7, "distance": -50, "color": "#12a9d1" }, "small": { "size": 5, "distance": -40, "color": "#5fd0ee" } },
      "logo": { "keyframe": "ctLogo", "duration": 0.5, "delay": 0.8, "asset": "assets/simbolo-construtec.png", "widthRatio": 0.72, "background": "transparent" },
      "referenceSize": 72
    },
    "keyframes": {
      "ctCheck": "0%{opacity:1;transform:scale(0)}20%{opacity:1;transform:scale(1.14)}32%{opacity:1;transform:scale(1)}64%{opacity:1;transform:scale(1)}74%{opacity:0;transform:scale(1.35)}100%{opacity:0;transform:scale(1.35)}",
      "ctRing": "0%{opacity:.9;transform:scale(.85)}100%{opacity:0;transform:scale(1.8)}",
      "ctBurst": "0%{opacity:0;transform:rotate(var(--r)) translateY(0) scale(.4)}15%{opacity:1}100%{opacity:0;transform:rotate(var(--r)) translateY(var(--d)) scale(1)}",
      "ctLogo": "0%{opacity:0;transform:scale(.3) rotate(-30deg)}60%{opacity:1;transform:scale(1.12) rotate(5deg)}100%{opacity:1;transform:scale(1) rotate(0)}",
      "shakeA": "10%,90%{transform:translateX(-2px)}20%,80%{transform:translateX(4px)}30%,50%,70%{transform:translateX(-7px)}40%,60%{transform:translateX(7px)}",
      "blobA": "to{transform:translate(90px,120px) scale(1.15)}",
      "blobB": "to{transform:translate(-100px,-60px) scale(.9)}",
      "blobC": "to{transform:translate(120px,-90px) scale(1.2)}",
      "bob": "from{transform:translateY(0)}to{transform:translateY(-6px)}",
      "shimmer": "0%{transform:translateX(-120%)}40%,100%{transform:translateX(320%)}",
      "scanY": "from{top:18px}to{top:92px}",
      "nodePulse": "0%{transform:scale(1);opacity:.7}100%{transform:scale(1.9);opacity:0}",
      "fadeUp": "from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}",
      "stepIn": "from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:none}",
      "checkPop": "from{transform:scale(0)}to{transform:scale(1)}",
      "pushIn": "from{opacity:0;transform:translateY(-24px) scale(.96)}to{opacity:1;transform:none}"
    }
  },
  "rules": {
    "pin": { "length": 6, "maxAttempts": 3, "rejectRepeated": true, "rejectSequences": ["0123456789", "9876543210"] },
    "password": { "minLength": 8, "criteria": ["8+ caracteres", "Letra maiúscula", "Um número", "Um símbolo"], "minCriteria": 3, "labels": ["Digite uma senha", "Fraca", "Razoável", "Boa", "Forte"] },
    "autoLock": { "options": ["Na hora", "1 min", "5 min", "15 min"], "default": "5 min" },
    "resetLinkMinutes": 30,
    "resendCooldownSeconds": 60,
    "handoffSeconds": 60
  }
}

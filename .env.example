# Identificação desta cópia. Use nomes diferentes nas duas máquinas.
INSTANCE_NAME=Financeiro - Lucas

# Primeiro usuário, criado somente quando o banco está vazio.
ADMIN_INITIAL_NAME=Administrador
ADMIN_INITIAL_EMAIL=admin@empresa.com
# No aplicativo Windows V3, a senha temporária é gerada em memória e não é gravada neste arquivo.
# Para execução manual fora do Electron, defina ADMIN_INITIAL_PASSWORD com pelo menos 10 caracteres.

# O aplicativo Windows gera este segredo automaticamente.
JWT_SECRET=troque-por-um-texto-aleatorio-com-pelo-menos-32-caracteres

PORT=3333
HOST=127.0.0.1
APP_TIMEZONE=America/Sao_Paulo
NODE_ENV=production

# Endpoint público central do Report V2.
REPORT_API_URL=https://centro-custos-reports.construtec-reports.workers.dev

# Observabilidade e limites. Os valores abaixo são seguros para a maioria das instalações.
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
DB_SLOW_QUERY_MS=500
JSON_BODY_LIMIT=110mb
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_HEADERS_TIMEOUT_MS=6500
HTTP_REQUEST_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=10000

# A V3 usa uma pasta própria para não tocar nos dados da versão anterior.
# Ajuste SEU_USUARIO quando configurar manualmente.
PGLITE_DATA_DIR=C:/Users/SEU_USUARIO/AppData/Roaming/Construtec/CentroCustosV3/pglite
RESTORE_ROOT_DIR=C:/Users/SEU_USUARIO/AppData/Roaming/Construtec/CentroCustosV3/dados

# Para migrar futuramente para PostgreSQL central:
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/centro_custos
# DB_SSL=true
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=10000

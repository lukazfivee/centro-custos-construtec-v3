{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "centro-custos-api",
  "main": "index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 11 * * *"] },
  // Impressao digital da chave fixa de assinatura do app (publica): libera os App Links
  // (/redefinir-senha e /cadastro abrem direto no app).
  "vars": { "ANDROID_CERT_SHA256": "0D:85:31:22:E7:A6:BC:5A:9E:FF:A7:49:1D:DF:99:8F:BB:3D:F7:0E:0F:DB:B0:D9:28:17:7B:25:C4:8E:E7:84" },
  "containers": [{
    "class_name": "CentroCustosApi",
    "image": "../../Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "CentroCustosApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CentroCustosApi"] }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "centro-custos-producao",
    "database_id": "95e0be7b-2f59-4af4-87c3-95dc6b0ef95c"
  }]
}

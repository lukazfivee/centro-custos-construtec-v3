<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Barra de status transparente: o conteudo desenha por baixo (edge-to-edge em MainActivity). -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#32A9CD</item>
        <item name="android:windowBackground">@color/suite_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/suite_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>

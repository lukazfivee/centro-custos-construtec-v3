{
  "name": "centro-de-custos",
  "version": "3.0.0",
  "private": true,
  "description": "Suíte desktop integrada da Construtec Engenharia",
  "main": "desktop/main-unified.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec",
    "test:e2e": "node --test --test-concurrency=1 --test-reporter=spec test/e2e/*.e2e.js",
    "test:coverage": "node --test --experimental-test-coverage",
    "verify": "npm run check && npm run test:ci",
    "electron": "electron desktop/main-unified.js",
    "build": "electron-builder --win --publish never && node scripts/fix-latest-yml.js",
    "build:portable": "electron-builder --win portable --publish never",
    "build:dir": "electron-builder --win --dir --publish never",
    "fix-yml": "node scripts/fix-latest-yml.js",
    "deploy:cloud": "node scripts/deploy-cloud.js",
    "deploy:cloud:dry": "node scripts/deploy-cloud.js --dry-run",
    "suite:prepare": "node scripts/build-suite-modules.js",
    "preelectron-unified": "npm run suite:prepare",
    "electron-unified": "electron desktop/main-unified.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.1.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "impeccable": "^4.1.0",
    "selenium-webdriver": "^4.49.0",
    "wrangler": "^4.131.2"
  },
  "build": {
    "appId": "com.construtec.suite",
    "productName": "Suíte Construtec",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "db.js",
      "routes/**/*",
      "services/**/*",
      "lib/**/*",
      "middleware/**/*",
      "migrations/**/*",
      "public/**/*",
      "desktop/main.js",
      "desktop/main-unified.js",
      "desktop/suite-modules.js",
      "desktop/preload.js",
      "modules/**/*",
      "desktop/icon.png"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/**/*",
      "node_modules/bcryptjs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "artifactName": "Suite-Construtec-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Suíte Construtec",
      "artifactName": "Suite-Construtec-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Suite-Construtec-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "lukazfivee",
      "repo": "centro-custos-construtec-v3"
    }
  }
}

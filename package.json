{
  "name": "centro-de-custos",
  "version": "3.0.0",
  "private": true,
  "description": "Centro de Custos Construtec V3 - gestao financeira offline com sincronizacao inteligente",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage",
    "verify": "npm run check && npm run test:ci",
    "electron": "electron desktop/main.js",
    "build": "electron-builder --win && node scripts/fix-latest-yml.js",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir",
    "fix-yml": "node scripts/fix-latest-yml.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.construtec.centro-custos",
    "productName": "Centro de Custos Construtec",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".env",
      "server.js",
      "db.js",
      "routes/**/*",
      "services/**/*",
      "lib/**/*",
      "middleware/**/*",
      "migrations/**/*",
      "public/**/*",
      "desktop/main.js",
      "desktop/preload.js",
      "desktop/icon.png"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/**/*",
      "node_modules/bcryptjs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "artifactName": "Centro-de-Custos-Construtec-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Centro de Custos Construtec",
      "artifactName": "Centro-de-Custos-Construtec-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Centro-de-Custos-Construtec-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "lukazfivee",
      "repo": "centro-custos-construtec-v3"
    }
  }
}
